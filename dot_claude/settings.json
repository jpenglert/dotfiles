{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GIT_OPTIONAL_LOCKS": "0"
  },
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(tail *)",
      "Bash(pwd *)",
      "Bash(cd *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(acli *)",
      "Bash(glab *)",
      "Bash(just *)",
      "Bash(make *)",
      "Bash(mvn test *)",
      "Bash(mvn spotless:apply *)",
      "Bash(bundle show *)",
      "Bash(pnpm *)",
      "Bash(jq *)",
      "Bash(docker compose *)",
      "Bash(docker exec *)",
      "Bash(docker info *)",
      "Bash(docker stats *)",
      "Bash(curl *)",
      "Bash(echo *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git -C ~/src/postal* diff)",
      "Bash(git -C ~/src/sendoso* diff)",
      "Bash(git -C ~/src/postal* log)",
      "Bash(git -C ~/src/sendoso* log)",
      "Bash(git -C ~/src/postal* status)",
      "Bash(git -C ~/src/sendoso* status)",
      "Bash(done)",
      "mcp__claude_ai_Datadog__aggregate_spans",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__get_project",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_initiatives",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__list_projects",
      "mcp__claude_ai_Linear__list_teams",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__claude_ai_Context7__query-docs",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__datadog-mcp__aggregate_events",
      "mcp__datadog-mcp__aggregate_spans",
      "mcp__datadog-mcp__analyze_datadog_logs",
      "mcp__datadog-mcp__check_datadog_mcp_setup",
      "mcp__datadog-mcp__get_datadog_dashboard",
      "mcp__datadog-mcp__get_datadog_metric",
      "mcp__datadog-mcp__get_datadog_metric_context",
      "mcp__datadog-mcp__get_datadog_trace",
      "mcp__datadog-mcp__list_datadog_skills",
      "mcp__datadog-mcp__load_datadog_skill",
      "mcp__datadog-mcp__search_datadog_dashboards",
      "mcp__datadog-mcp__search_datadog_events",
      "mcp__datadog-mcp__search_datadog_incidents",
      "mcp__datadog-mcp__search_datadog_logs",
      "mcp__datadog-mcp__search_datadog_metrics",
      "mcp__datadog-mcp__search_datadog_monitors",
      "mcp__datadog-mcp__search_datadog_services",
      "mcp__datadog-mcp__search_datadog_spans",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-get-comments",
      "mcp__notion__notion-search",
      "mcp__sendoso-internal__describe_resource",
      "mcp__sendoso-internal__list_resources",
      "mcp__sendoso-internal__query_resource",
      "Read(~/src/postal/**)",
      "Read(~/src/sendoso/**)",
      "Skill(dhh-reviewer)",
      "Skill(fowler-reviewer)",
      "Skill(gitlab-cli-mr)",
      "Skill(matz-reviewer)",
      "Skill(dev:git-branch)",
      "Skill(dev:git-commit)",
      "Skill(dev:gitlab-mr)",
      "Skill(dev:start-work)",
      "Skill(superpowers:systematic-debugging)",
      "WebFetch(domain:app.notion.com)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:support.anthropic.com)",
      "WebFetch(domain:support.claude.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.local/share/chezmoi",
      "~/src/knowledge",
      "~/src/postal",
      "~/src/sendoso"
    ]
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "hyperframes": "off",
    "hyperframes-cli": "off",
    "hyperframes-registry": "off",
    "website-to-hyperframes": "off",
    "gsap": "off",
    "codebase-to-course": "off",
    "find-skills": "off",
    "grill-me": "off",
    "beck-reviewer": "off",
    "guido-reviewer": "off",
    "atlassian-acli": "off",
    "gitlab-cli-mr": "off",
    "sendoso-commit-helper": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true,
    "dev@sendoso": true,
    "ruby-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ops@sendoso": false,
    "playground@claude-plugins-official": false,
    "rails-upgrade@ombulabs-ai": true,
    "rails-load-defaults@ombulabs-ai": true,
    "dual-boot@ombulabs-ai": true,
    "upgrade-cleanup@ombulabs-ai": true
  },
  "extraKnownMarketplaces": {
    "ombulabs-ai": {
      "source": {
        "source": "git",
        "url": "https://github.com/ombulabs/claude-skills.git"
      }
    }
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/src/knowledge",
        "~/src/sendoso"
      ]
    },
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "git ls-remote *",
      "git clone *",
      "glab *"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
