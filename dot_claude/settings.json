{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(tail *)",
      "Bash(pwd *)",
      "Bash(cd *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(acli *)",
      "Bash(glab *)",
      "Bash(just *)",
      "Bash(make *)",
      "Bash(mvn test *)",
      "Bash(mvn spotless:apply *)",
      "Bash(pnpm *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(echo *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git -C ~/src/postal* diff)",
      "Bash(git -C ~/src/sendoso* diff)",
      "Bash(git diff)",
      "Bash(git -C ~/src/postal* log)",
      "Bash(git -C ~/src/sendoso* log)",
      "Bash(git log)",
      "Bash(git -C ~/src/postal* status)",
      "Bash(git -C ~/src/sendoso* status)",
      "Bash(git status)",
      "Bash(done)",
      "Glob(~/src/postal/**)",
      "Glob(~/src/sendoso/**)",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__list_projects",
      "mcp__claude_ai_Linear__list_teams",
      "mcp__datadog-mcp__aggregate_events",
      "mcp__datadog-mcp__check_datadog_mcp_setup",
      "mcp__datadog-mcp__get_datadog_metric",
      "mcp__datadog-mcp__list_datadog_skills",
      "mcp__datadog-mcp__load_datadog_skill",
      "mcp__datadog-mcp__search_datadog_incidents",
      "mcp__datadog-mcp__search_datadog_metrics",
      "mcp__datadog-mcp__search_datadog_monitors",
      "mcp__datadog-mcp__search_datadog_services",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-get-comments",
      "mcp__sendoso-internal__describe_resource",
      "mcp__sendoso-internal__list_resources",
      "mcp__sendoso-internal__query_resource",
      "Read(~/src/postal/**)",
      "Read(~/src/sendoso/**)",
      "Skill(dhh-reviewer)",
      "Skill(fowler-reviewer)",
      "Skill(gitlab-cli-mr)",
      "Skill(matz-reviewer)",
      "Skill(dev:git-branch)",
      "Skill(dev:git-commit)",
      "Skill(dev:gitlab-mr)",
      "Skill(dev:start-work)",
      "Skill(superpowers:systematic-debugging)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)"
    ],
    "additionalDirectories": [
      "~/.local/share/chezmoi",
      "~/src/postal",
      "~/src/sendoso"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true,
    "dev@sendoso": true,
    "ruby-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ops@sendoso": true,
    "playground@claude-plugins-official": true,
    "rails-upgrade@ombulabs-ai": true,
    "rails-load-defaults@ombulabs-ai": true,
    "dual-boot@ombulabs-ai": true,
    "upgrade-cleanup@ombulabs-ai": true
  },
  "extraKnownMarketplaces": {
    "ombulabs-ai": {
      "source": {
        "source": "git",
        "url": "https://github.com/ombulabs/claude-skills.git"
      }
    }
  },
  "agentPushNotifEnabled": true
}
