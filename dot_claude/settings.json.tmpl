{{- end }}
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/src/knowledge",
        "~/src/sendoso",
        "~/src/postal"
      ]
    },
    "excludedCommands": [
      "docker *",
      "docker compose *",
      "git checkout *",
      "git clone *",
      "git fetch *",
      "git ls-remote *",
      "git pull *",
      "git push *",
      "git switch *",
      "glab *",
      "just *"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
