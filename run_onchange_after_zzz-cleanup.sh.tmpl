{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Kill the sudo keepalive background process if it's still running
PIDFILE="/tmp/chezmoi-sudo-keepalive.pid"
if [[ -f "$PIDFILE" ]]; then
    PID=$(cat "$PIDFILE")
    if kill -0 "$PID" 2>/dev/null; then
        kill "$PID" 2>/dev/null || true
        echo "Sudo keepalive stopped (PID: $PID)"
    fi
    rm -f "$PIDFILE"
fi

echo "Chezmoi setup complete!"
{{ end -}}
