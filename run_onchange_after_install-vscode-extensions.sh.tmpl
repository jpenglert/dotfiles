{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -e

# extensions hash: {{ include ".chezmoidata/code-extensions.yaml" | sha256sum }}

# Install to VS Code if available
if command -v code &>/dev/null; then
    echo "Installing extensions to VS Code..."
{{- range .extensions.universal }}
    code --install-extension "{{ . }}" --force
{{- end }}
{{- range .extensions.vscode }}
    code --install-extension "{{ . }}" --force
{{- end }}
fi

# Install to Cursor if available
if command -v cursor &>/dev/null; then
    echo "Installing extensions to Cursor..."
{{- range .extensions.universal }}
    cursor --install-extension "{{ . }}" --force
{{- end }}
{{- range .extensions.cursor }}
    cursor --install-extension "{{ . }}" --force
{{- end }}
fi
{{ end -}}
