# Ghostty configuration. Reference: `ghostty +show-config --default --docs`

font-family = MesloLGM Nerd Font Mono
font-size = 13

# Lines scrolled per mouse-wheel notch (discrete) and trackpad scale (precision).
mouse-scroll-multiplier = precision:1,discrete:1

# Option acts as Alt (shell word jumps, Alt keybinds) instead of typing special characters.
macos-option-as-alt = true

# Cmd+Option+] / [ switch to the next / previous herdr agent by sending the
# ctrl+alt+n / ctrl+alt+p sequences bound in herdr's config.toml.
keybind = super+alt+]=text:\x1b\x0e
keybind = super+alt+[=text:\x1b\x10

# BEGIN herdr-agent-usage font
font-codepoint-map = U+E1A0-U+E1B6="Herdr Agent Icons Max"
font-codepoint-map = U+E1C0-U+E1C5="Herdr Agent Icons Max"
# END herdr-agent-usage font
