{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Ensure brew is available in this shell session
eval "$({{ template "brew-prefix" . }}/bin/brew shellenv)"
BREW_PREFIX=$(brew --prefix)

# Install packages using brew bundle
# packages hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# isWorkComputer: {{ .isWorkComputer }}
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.universal.taps -}}
tap "{{ . }}"
{{ end -}}
{{ range .packages.universal.brews -}}
brew "{{ . }}"
{{ end -}}
{{ range .packages.universal.casks -}}
cask "{{ . }}"
{{ end -}}
{{ if .isWorkComputer -}}
{{ range .packages.work.taps -}}
tap "{{ . }}"
{{ end -}}
{{ range .packages.work.brews -}}
brew "{{ . }}"
{{ end -}}
{{ range .packages.work.casks -}}
cask "{{ . }}"
{{ end -}}
{{ end -}}
EOF

# Create sha256sum symlink (coreutils installs gsha256sum)
ln -sf "${BREW_PREFIX}/bin/gsha256sum" "${BREW_PREFIX}/bin/sha256sum"

# Cleanup outdated versions
brew cleanup
{{ end -}}
