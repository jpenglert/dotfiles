{{- if eq .chezmoi.os "darwin" }}
# Add brew to path
eval $({{ template "brew-prefix" . }}/bin/brew shellenv)

# Use brew installed GNU utilities over macOS built-ins
export PATH="{{ template "brew-prefix" . }}/opt/coreutils/libexec/gnubin:$PATH"
export PATH="{{ template "brew-prefix" . }}/opt/gnu-sed/libexec/gnubin:$PATH"
export PATH="{{ template "brew-prefix" . }}/opt/grep/libexec/gnubin:$PATH"

# Local bin dirs
export PATH=$HOME/.local/bin:$PATH
export PATH=$HOME/.local/share/bin:$PATH
export PATH=$HOME/bin:$PATH

# git-fuzzy
export PATH="$HOME/.git-fuzzy/bin:$PATH"

# LM Studio CLI (lms)
export PATH="$HOME/.lmstudio/bin:$PATH"

{{- end }}

{{- if .isWorkComputer }}
# mise shims, for processes that never source .zshrc (Dock-launched apps,
# LaunchAgents). Interactive shells get the richer `mise activate` in .zshrc,
# which also applies env vars from mise.toml / mise.local.toml.
export PATH="$HOME/.local/share/mise/shims:$PATH"

# Sendoso oso-cli
export PATH="$HOME/src/sendoso/oso-cli:$PATH"
{{- end }}
